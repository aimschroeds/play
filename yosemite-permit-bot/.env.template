# 1Password secret references — resolved at runtime via:
#   op run --env-file .env.template -- <command>
#
# To set up the vault item, see CLAUDE.md.

# ── Webhook auth (shared secret — set in iOS Shortcut header too) ────────────
WEBHOOK_SECRET=op://Development/twilio-yosemite-bot/webhook-secret

# ── Slack (outbound "permit in cart" notifications) ──────────────────────────
SLACK_WEBHOOK_URL=op://Development/twilio-yosemite-bot/slack-webhook-url

# ── ngrok (optional — paid static domain only) ──────────────────────────────
# If you have a paid ngrok plan with a static domain, add it to the vault item
# and reference it here. Otherwise leave blank — start_server.sh will start
# ngrok automatically.
NGROK_URL=
