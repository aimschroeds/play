# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then either source it before running:
#   source .env
# Or start_server.sh will source it automatically if .env is present.
#
# DO NOT commit .env to git (it's in .gitignore).

# ── Twilio ─────────────────────────────────────────────────────────────────────
# Find these at console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (the one you gave to Outdoor Status)
TWILIO_FROM=+15551234567

# YOUR real phone number — this is where the "cart is ready" alert goes
ALERT_PHONE=+15559876543

# ── ngrok (optional — paid static domain only) ─────────────────────────────────
# If you have a paid ngrok plan with a static domain, set it here and
# start_server.sh will skip launching ngrok and just use this URL.
# Leave blank (or delete this line) if you are on the free plan — the script
# will start ngrok automatically and print the URL for you.
#
# Example (paid static domain):
#   NGROK_URL=https://your-subdomain.ngrok-free.app
#
NGROK_URL=
